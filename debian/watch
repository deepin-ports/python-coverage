# debian/watch
# Debian UScan configuration for this package.
# Manual page: ‘uscan(1)’.

# Version of UScan configuration format.
version = 4

# Public releases at Debian redirector for Python Package Index.
opts = " \
        uversionmangle=s/(\d)((?:a|b|c|rc)\d*)$/$1~$2/, \
        pgpmode=none, \
        repack, \
        repacksuffix=+dfsg1, \
        dversionmangle=s/\+dfsg\d+$//, \
        " \
    https://pypi.debian.net/coverage/ \
    /coverage/coverage-@ANY_VERSION@@ARCHIVE_EXT@ \
    debian uupdate


